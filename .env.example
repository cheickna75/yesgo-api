# Server
PORT=3000
NODE_ENV=development

# Database PostgreSQL (local)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=moto_share_africa
DB_USER=postgres
DB_PASSWORD=

# Database PostgreSQL (cloud — Railway/Render, remplace les variables ci-dessus)
DB_URL=postgres://user:password@host:5432/dbname

# JWT
JWT_SECRET=change_me_in_production
JWT_EXPIRES_IN=7d

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=whsec_XXXXXXXXXXXXXXXXXXXXXXXX

# URL publique du backend (utilisée pour les redirections Stripe)
# En développement : http://192.168.1.199:3000
# En production    : https://ton-app.railway.app
APP_URL=http://192.168.1.199:3000
