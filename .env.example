# Server
PORT=3000
NODE_ENV=development

# Database PostgreSQL (local)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=moto_share_africa
DB_USER=postgres
DB_PASSWORD=

# Database PostgreSQL (cloud — Railway/Render, remplace les variables ci-dessus)
DB_URL=postgres://user:password@host:5432/dbname

# JWT
JWT_SECRET=change_me_in_production_minimum_32_caracteres
JWT_EXPIRES_IN=7d

# URL publique du backend
# En développement : http://192.168.1.xxx:3000 ou ngrok
# En production    : https://web-production-b226e.up.railway.app
APP_URL=http://192.168.1.199:3000

# CinetPay — paiement principal (Afrique de l'Ouest)
# Utiliser les clés prod OU les clés test (les clés prod ont priorité)
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
CINETPAY_TEST_API_KEY=
CINETPAY_TEST_SITE_ID=
# Mot de passe de transfert (virements vers les conducteurs)
CINETPAY_TRANSFER_PASSWORD=

# Commission YesGo
# BETA_MODE=true  → 0% de commission (lancement)
# BETA_MODE=false → BETA_COMMISSION_RATE% appliqué
BETA_MODE=true
BETA_COMMISSION_RATE=0

# Cloudinary — stockage persistant des documents d'identité (obligatoire en production)
# Créer un compte gratuit sur cloudinary.com → Dashboard → API Keys
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Twilio — envoi de SMS pour OTP (inscription et réinitialisation de mot de passe)
# Créer un compte sur twilio.com → Console → Account Info
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Numéro Twilio au format international, ex: +12015551234
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX

# Stripe — paiement international par carte (optionnel)
# Laisser vide pour désactiver Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
